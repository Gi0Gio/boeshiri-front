# URL base de la API, SIN barra final.
#
# Local: apunta a la API que levantas tú (dotnet run --project Boeshiri.Api).
# Producción: NO se define aquí, sino en el hosting. Ver netlify.env.
#
# Aviso: todo lo que empiece por VITE_ se incrusta en el bundle y es PÚBLICO.
# Nunca pongas aquí claves ni secretos.
VITE_API_URL=http://localhost:8080
